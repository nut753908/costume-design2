#!/usr/bin/env bash
set -euo pipefail

echo "pre-commit: build"
npm run build

echo "pre-commit: test"
npm test

echo "pre-commit: lint"
npm run lint

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

echo "pre-commit: CLAUDE.md / SKILL.md check"
# 警告だけでコミットは止めない。文字数は wc -m(バイト数ではない)で数える。
max_chars=6000
max_total_chars=20000
history_pattern='以前は|旧実装|かつて|これまでどおり|従来(どおり|の)|修正前|実際に発生|最初に試した|以前.*に相当'
# バッククォート内の、ディレクトリ区切りと拡張子を持つパスだけを対象にする。
path_pattern='[A-Za-z0-9_.@-]*/[A-Za-z0-9_./@-]*\.(ts|tsx|js|mjs|css|json|md)'

claude_md_staged=0
while IFS= read -r f; do
  # 文字数は CLAUDE.md だけ(常に読み込まれるため)。経緯の表現と参照の実在はスキルも調べる。
  case "$f" in
    CLAUDE.md|*/CLAUDE.md) is_claude_md=1 ;;
    .claude/skills/*/SKILL.md) is_claude_md=0 ;;
    *) continue ;;
  esac
  content=$(git show ":$f")
  if [ "$is_claude_md" -eq 1 ]; then
    claude_md_staged=1
    chars=$(printf '%s' "$content" | LC_ALL=C.UTF-8 wc -m)
    if [ "$chars" -gt "$max_chars" ]; then
      echo "  warning: $f が ${chars} 文字あります(目安 ${max_chars} 文字)。コードから分かる記述・重複を削れないか確認してください。"
    fi
  fi
  added=$(git diff --cached -U0 -- "$f" | grep -E '^\+[^+]' | grep -E "$history_pattern" || true)
  if [ -n "$added" ]; then
    echo "  warning: $f の追加行に、履歴表現(経緯の記述)らしき箇所があります。今の設計だけを書いてください:"
    echo "$added" | sed 's/^+/    /'
  fi
  # 参照先は、そのファイルのディレクトリ・リポジトリのルート・node_modules/ からの相対パスか、
  # 追跡中のファイルの末尾(`generic/foo.ts` のような短い書き方)と一致すればよい。
  doc_dir=$(dirname "$f")
  while IFS= read -r ref; do
    [ -z "$ref" ] && continue
    found=0
    if [ -e "$doc_dir/$ref" ] || [ -e "$ref" ] || [ -e "node_modules/$ref" ] \
      || [ -n "$(git ls-files -- "*/$ref")" ]; then
      found=1
    fi
    if [ "$found" -eq 0 ]; then
      echo "  warning: $f が参照している $ref が見つかりません。"
    fi
  done < <(printf '%s' "$content" | grep -oE '`[^`]+`' | grep -oE "$path_pattern" | sort -u)
done <<< "$staged_files"

if [ "$claude_md_staged" -eq 1 ]; then
  total=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    n=$(git show ":$f" | LC_ALL=C.UTF-8 wc -m)
    total=$((total + n))
  done < <(git ls-files -- 'CLAUDE.md' '*/CLAUDE.md')
  if [ "$total" -gt "$max_total_chars" ]; then
    echo "  warning: CLAUDE.md の合計が ${total} 文字あります(目安 ${max_total_chars} 文字)。"
  fi
fi
