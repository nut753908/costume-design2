#!/usr/bin/env bash
set -euo pipefail

echo "pre-commit: build"
npm run build

echo "pre-commit: test"
npm test

echo "pre-commit: lint"
npm run lint

echo "pre-commit: CLAUDE.md sync reminder"
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

declare -A staged_set=()
while IFS= read -r sf; do
  [ -n "$sf" ] && staged_set["$sf"]=1
done <<< "$staged_files"

declare -A missing_docs=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    CLAUDE.md|*/CLAUDE.md) continue ;;
  esac
  dir=$(dirname "$f")
  while :; do
    if [ "$dir" = "." ]; then
      doc="CLAUDE.md"
    else
      doc="$dir/CLAUDE.md"
    fi
    if [ -f "$doc" ]; then
      if [ -z "${staged_set[$doc]:-}" ]; then
        missing_docs["$doc"]="$f"
      fi
      break
    fi
    [ "$dir" = "." ] && break
    dir=$(dirname "$dir")
  done
done <<< "$staged_files"

if [ ${#missing_docs[@]} -gt 0 ]; then
  echo ""
  echo "  reminder: 以下の CLAUDE.md は今回の変更と関連する可能性があります(コミットには含まれていません)。"
  echo "  内容が古くなっていないか確認してください(不要なら無視して構いません):"
  for doc in "${!missing_docs[@]}"; do
    echo "    - $doc (例: ${missing_docs[$doc]})"
  done
  echo ""
fi

echo "pre-commit: CLAUDE.md size / history-phrase check"
# 警告だけでコミットは止めない。文字数は wc -m(バイト数ではない)で数える。
max_chars=25000
history_pattern='以前は|旧実装|かつては|これまでどおり|以前.*に相当'
while IFS= read -r f; do
  case "$f" in
    CLAUDE.md|*/CLAUDE.md) ;;
    *) continue ;;
  esac
  chars=$(git show ":$f" | LC_ALL=C.UTF-8 wc -m)
  if [ "$chars" -gt "$max_chars" ]; then
    echo "  warning: $f が ${chars} 文字あります(目安 ${max_chars} 文字)。重複や導出可能な記述を削れないか確認してください。"
  fi
  added=$(git diff --cached -U0 -- "$f" | grep -E '^\+[^+]' | grep -E "$history_pattern" || true)
  if [ -n "$added" ]; then
    echo "  warning: $f の追加行に、履歴表現(経緯の記述)らしき箇所があります。CLAUDE.md には今の設計だけを書いてください:"
    echo "$added" | sed 's/^+/    /'
  fi
done <<< "$staged_files"
